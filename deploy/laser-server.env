# Copied to /etc/laser-server.env by install.sh. Restart after editing:
#   sudo systemctl restart laser-server
LASER_HTTP_PORT=8000
# "auto" picks the first /dev/serial/by-id, /dev/ttyUSB* or /dev/ttyACM* device
LASER_SERIAL_PORT=auto
LASER_BAUD=115200
# Camera index (0 = /dev/video0) or a device path
LASER_CAMERA=0
LASER_CAMERA_WIDTH=1280
LASER_CAMERA_HEIGHT=720
LASER_CAMERA_FPS=10
# Uncomment to require a password (any username) for the web UI
#LASER_PASSWORD=change-me
